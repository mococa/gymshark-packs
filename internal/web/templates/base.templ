package templates

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title }</title>
		<link rel="stylesheet" href="/static/css/style.css"/>
	</head>
	<body>
		<header>
			<h1>RE Partners Pack Calculator</h1>
			<p class="subtitle">Calculate optimal pack sizes for customer orders</p>
		</header>
		<main>
			{ children... }
		</main>
		<footer>
			<p>Built by <a href="https://moureau.dev" target="_blank">Luiz Moureau</a> | <a href="/docs/">API Docs</a></p>
		</footer>
		<script src="/static/js/app.js"></script>
	</body>
	</html>
}
